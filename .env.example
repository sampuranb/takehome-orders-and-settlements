# Copy to .env for local development. cargo-leptos reads the nearest .env
# automatically and passes it to the server process.

# This application's own PostgreSQL database, separate from the database the
# shared Better Auth service uses for users and sessions.
DATABASE_URL=postgresql://takehome:takehome@localhost:5432/orders_settlements

# Base URL of the shared Better Auth service. No trailing slash required; one
# is trimmed if present.
BETTER_AUTH_URL=http://localhost:3005

# cargo-leptos exports this itself for `build`, `serve`, and `watch`. A bare
# binary (for example in Docker) must set it, otherwise get_configuration
# produces an empty output name and every /pkg/* asset URL silently 404s.
LEPTOS_OUTPUT_NAME=orders

# Optional. Defaults come from [package.metadata.leptos] in Cargo.toml.
# LEPTOS_SITE_ADDR=127.0.0.1:3000
# LEPTOS_SITE_ROOT=target/site
# LEPTOS_SITE_PKG_DIR=pkg

# Optional tracing filter. Defaults to the value below when unset.
# RUST_LOG=info,orders_and_settlements=debug,tower_http=info
