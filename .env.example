COMPOSE_PROJECT_NAME=takehome-orders
AUTH_PORT=3005
APP_PORT=5174

# Generated automatically by scripts/setup.sh. Never commit a populated .env.
BETTER_AUTH_SECRET=replace-with-64-random-hex-characters
AUTH_DB_PASSWORD=replace-with-random-url-safe-password
APP_DB_PASSWORD=replace-with-random-url-safe-password

# Direct cargo-leptos development (Compose overrides these internally).
DATABASE_URL=postgresql://orders:replace-with-random-url-safe-password@localhost:5432/orders
BETTER_AUTH_URL=http://localhost:3005
LEPTOS_OUTPUT_NAME=orders
