# Rust and cargo-leptos build output (target/ also contains target/site).
/target

# Local environment. Copy .env.example to .env; cargo-leptos loads it
# automatically. Never commit real credentials.
.env
.env.local

# Playwright. The spec and its package.json are committed; the toolchain it
# downloads and the artifacts it writes are not.
node_modules
/tests/test-results
/tests/playwright-report

*.log
.DS_Store

# Internal working notes, kept out of the submission.
IMPLEMENTATION_PLAN.md
